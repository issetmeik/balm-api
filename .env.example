# ---------------------------------------------------------------------------
# Copie para .env e ajuste. NUNCA commite o .env real.
# Validado por src/config/env.ts (zod) — a API não sobe com config inválida.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
API_PORT=3333
API_URL=http://localhost:3333

# --- Banco (obrigatório) --- porta 5434 = docker-compose.yml deste repo
DATABASE_URL=postgresql://balm:balm@localhost:5434/balm?schema=public

# --- Redis (opcional: fila de ingestão / cache / rate limit) ---
REDIS_URL=redis://localhost:6379

# --- Auth (segredos com no mínimo 16 caracteres) ---
# Gere segredos fortes: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Chave para assinar/validar tokens de dispositivo (ingestão de telemetria)
DEVICE_TOKEN_SECRET=change-me-device-secret-32chars-min

# --- Observabilidade ---
LOG_LEVEL=debug

# --- CORS (lista separada por vírgula) ---
CORS_ORIGINS=http://localhost:5173
